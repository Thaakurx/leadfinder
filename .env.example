# Google Cloud API key with "Places API (New)" and "Geocoding API" enabled.
# See README.md for step-by-step setup instructions. Optional here — can
# instead be set from the in-app Settings page (gear icon), which takes
# priority over this if both are set.
GOOGLE_PLACES_API_KEY=

# If set, gates the entire app behind a single shared password (login page
# at /login). Required for any public deployment — there is no per-user
# login system, so leaving this unset on a publicly reachable host means
# anyone with the URL has full access. Leave unset for local dev.
APP_PASSWORD=

# Local dev default (SQLite, file-based). To use Postgres instead, set this to
# a postgresql:// URL and change `provider` in prisma/schema.prisma to
# "postgresql".
DATABASE_URL="file:./dev.db"

# Enrichment crawler tuning (optional, sensible defaults used if unset).
ENRICHMENT_REQUESTS_PER_SECOND_PER_DOMAIN=1
ENRICHMENT_TIMEOUT_MS=8000
ENRICHMENT_CONCURRENCY=5

# Optional: override the assumed $/request used for the pre-search cost
# estimate (see lib/cost.ts). Verify current pricing at
# https://mapsplatform.google.com/pricing/ — defaults to an approximation.
GOOGLE_PLACES_COST_PER_REQUEST_USD=0.035
